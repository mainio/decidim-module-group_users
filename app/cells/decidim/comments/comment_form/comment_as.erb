<% append_javascript_pack_tag "decidim_group_users", defer: false %>
<% append_stylesheet_pack_tag "decidim_group_users" %>

<% if comment_as_options.length > 1 %>
  <div class="comment__as" data-controller="comment-as">
    <button id="dropdown-trigger-<%= comment_as_id %>"
            data-controller="dropdown"
            data-target="dropdown-menu-<%= comment_as_id %>"
            data-auto-close="true">
      <div class="comment__as-author-selected">
        <label class="ml-10 text-left text-xs" for="<%= comment_as_id %>">
          <%= t("decidim.components.add_comment_form.form.user_group_id.your_profile") %>
        </label>
        <span data-comment-as-target="display" class="flex items-center gap-2"></span>
      </div>
      <%= icon "arrow-down-s-line" %>
      <%= icon "arrow-up-s-line" %>
    </button>

    <ul id="dropdown-menu-<%= comment_as_id %>"
        data-comment-as-target="menu"
        class="gap-4">
      <% comment_as_options.each do |option| %>
        <li class="comment__as-author-container"
            data-comment-as-target="option"
            data-action="click->comment-as#select">
          <div class="comment__as-author-info">
            <div class="author__avatar-container border border-white">
              <%= image_tag option[0].avatar_url(:thumb),
                            alt: t("decidim.author.avatar", name: option[0].name),
                            class: "author__avatar" %>
            </div>
            <p class="comment__as-author-name"><%= option[0].name %></p>
          </div>
          <input type="radio"
                 name="comment[user_group_id]"
                 class="w-5 h-4"
                 value="<%= option[1] %>">
        </li>
      <% end %>
    </ul>
  </div>
<% else %>
  <div class="comment__as">
    <div class="comment__as-author-info">
      <div class="author__avatar-container border border-white">
        <%= image_tag comment_as_options.first[0].avatar_url(:thumb),
                      alt: t("decidim.author.avatar", name: comment_as_options.first[0].name),
                      class: "author__avatar" %>
      </div>
      <p class="comment__as-author-name"><%= comment_as_options.first[0].name %></p>
    </div>
  </div>
<% end %>